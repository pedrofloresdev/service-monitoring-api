# Copy to .env and adjust. Lists exactly the settings the app and Alembic read.

# Required. PostgreSQL connection string used by the app and by `alembic upgrade head`.
# With `docker compose`, the api container overrides this value (see docker-compose.yml).
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/service_monitoring_api

# Consecutive failed checks before a service is reported DOWN.
FAIL_THRESHOLD=3

# HTTP timeout per check, in seconds.
CHECK_TIMEOUT_SECONDS=10
