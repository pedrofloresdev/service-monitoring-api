# Copy to .env and adjust. Lists exactly the settings the app and Alembic read.

# Required. PostgreSQL connection string used by the app and by `alembic upgrade head`.
# With `docker compose`, the api container overrides this value (see docker-compose.yml).
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/service_monitoring_api

# Consecutive failed checks before a service is reported DOWN.
FAIL_THRESHOLD=3

# HTTP timeout per check, in seconds.
CHECK_TIMEOUT_SECONDS=10

# Maximum time, in seconds, to resolve a service hostname (IPv4 and IPv6 together),
# when a service is created/updated and before every check. Decimal, > 0 and <= 30.
RESOLUTION_TIMEOUT_SECONDS=2

# Demo mode (spec 003a). Off unless set to true/1/yes/on (false/0/no/off also accepted).
# Any other value stops startup. The DEMO_* settings below are read only while it is on.
# A public demo also needs specs 003b-003d (see README "Running a public demo").
DEMO_MODE=false

# JSON array of 1 to 20 example services: name, url, optional expected_status/check_interval.
# DEMO_SEED_SERVICES=[{"name": "Example", "url": "https://example.com/"}]

# Visitor services allowed at once, and per host. Per-host must not exceed global.
# DEMO_GLOBAL_VISITOR_CAP=20
# DEMO_PER_HOST_VISITOR_CAP=3

# Minimum check interval for visitor services, in seconds (also their default).
# DEMO_MIN_CHECK_INTERVAL_SECONDS=300
